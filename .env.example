DATABASE_URL=postgresql://olnoo_admin:CHANGE_ME@localhost:5432/olnoo_admin

# OLNOO AI Router — used server-side only for SEO keyword clustering.
AI_ROUTER_URL=http://127.0.0.1:3010
OLNOO_ROUTER_TOKEN=

# Shared secret for server-to-server lead intake (POST /api/leads/inbound).
# Must match OLNOO_CRM_API_KEY on the public site(s) that submit leads here.
# Server-side only — never read by any client component.
OLNOO_CRM_API_KEY=

# Telegram Bot API token for Social's "Publish to Telegram" (POST /api/social-publications/[id]/publish-telegram).
# Server-side only — never stored in the DB or in Git, never read by any client component.
TELEGRAM_BOT_TOKEN=
# Optional override, only for pointing a non-production environment at a mock Telegram API.
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Chat id the owner's Telegram notification for a new CRM lead is sent to (reuses TELEGRAM_BOT_TOKEN
# above — no separate bot/token). Sent once per genuinely new lead created through createLeadRecord
# (lib/crm.ts), never on an idempotent lead_tracking_id replay, a PATCH, a status/notes change, or a
# DELETE. Unset, or a Telegram API failure, never blocks or rolls back the lead save — it just skips
# the notification and logs. Server-side only — never stored in the DB or in Git, never read by any
# client component.
CRM_NOTIFY_TELEGRAM_CHAT_ID=

# Telegram Business intake (POST /api/telegram/business-webhook) — a separate bot/token from
# TELEGRAM_BOT_TOKEN above. Accepts business_connection/business_message updates for any
# connected account, but only ever creates a CRM lead for the one connection configured as
# TELEGRAM_BUSINESS_DRIVESET_CONNECTION_ID (Patch D) — every other connection's incoming messages
# stay ignored, same as Patch A. Server-side only — never stored in the DB or in Git, never read
# by any client component.
TELEGRAM_BUSINESS_BOT_TOKEN=
# Registered once by hand via setWebhook's secret_token; compared to the
# X-Telegram-Bot-Api-Secret-Token header on every call.
TELEGRAM_BUSINESS_WEBHOOK_SECRET=
# The Telegram user id of the business account's own owner (e.g. @driveset's personal account) —
# used only to recognise and ignore the owner's own outgoing messages (a manager's reply is never
# a lead). Numeric, as a string.
TELEGRAM_BUSINESS_OWNER_USER_ID=
# CRM project slug new leads from this integration are created under (e.g. "driveset").
TELEGRAM_BUSINESS_PROJECT=
# The business_connection_id of the one connection allowed to create a lead (DriveSet's — found
# via a business_connection update's "id" field once @driveset actually connects the bot). Empty
# or unset = no connection is allowed to create a lead (fail closed), exactly like before this
# var existed.
TELEGRAM_BUSINESS_DRIVESET_CONNECTION_ID=

# Telegram channel comments intake (POST /api/telegram/comments-webhook) — Social Community MVP.
# Uses the SAME bot/token as autoposting, TELEGRAM_BOT_TOKEN above (no new bot): that token had no
# webhook and no getUpdates polling registered anywhere before this, so this is its first and
# only webhook. Registered once by hand via setWebhook's secret_token; compared to the
# X-Telegram-Bot-Api-Secret-Token header on every call, same as TELEGRAM_BUSINESS_WEBHOOK_SECRET
# above but for a different bot/purpose. Unset means the route refuses every request (fails
# closed, not open). Server-side only — never stored in the DB or in Git, never read by any client
# component. See deploy/social-comments-webhook/README.md for the exact registration steps and the
# manual admin action required on the channel/discussion-group side before this can work at all.
TELEGRAM_COMMENTS_WEBHOOK_SECRET=

# VK autoposting (POST /api/social-publications/[id]/publish-vk) no longer uses one global token —
# each project connects its own VK community's access token via Social → Accounts, encrypted at
# rest with SOCIAL_ACCOUNT_ENCRYPTION_KEY below (see lib/social-vk.ts, lib/social-accounts-vk-
# connection.ts, db/migrations/0021_social_accounts_vk_credentials.sql). VK_ACCESS_TOKEN is no
# longer read by the publisher; it is kept here only as a reminder of the token type required —
# a community/group access token (or a user token with wall,groups scope) obtained via VK's classic
# OAuth or the community's own API settings, NOT a vk2.a.* token from the newer id.vk.com PKCE login
# flow, which cannot call wall.post.
# Optional override, only for pointing a non-production environment at a mock VK API.
VK_API_BASE_URL=https://api.vk.com

# Encrypts per-account platform credentials stored in social_accounts (currently just VK's access
# token — see above) at rest: AES-256-GCM, base64-encoded, must decode to exactly 32 bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Server-side only — never stored in Git. Unset blocks connecting or publishing through any VK
# account (fails closed, same as every other credential in this app) rather than storing/reading a
# token in plaintext.
SOCIAL_ACCOUNT_ENCRYPTION_KEY=

# Instagram API with Instagram Login, for Social's "Publish to Instagram"
# (POST /api/social-publications/[id]/publish-instagram). A long-lived Instagram User access
# token, scoped to one specific Instagram professional account — obtain it via Meta's "Business
# Login for Instagram" one-time browser OAuth, then exchange the short-lived token for a
# long-lived one (ig_exchange_token). Refresh before it expires (60 days).
# Server-side only — never stored in the DB or in Git, never read by any client component.
#
# This is now a FALLBACK only, still pinned to one project by INSTAGRAM_OWNER_PROJECT below — the
# preferred path is each project connecting its own Instagram account from Social → Accounts
# (stored encrypted in social_accounts, via SOCIAL_ACCOUNT_ENCRYPTION_KEY above; no env var
# needed). See OLNOO_PROJECT_MAP.md → "Instagram/Threads account connection — Social Connect MVP".
INSTAGRAM_ACCESS_TOKEN=
# The numeric Instagram professional account id the token above is scoped to (GET
# https://graph.instagram.com/me?fields=user_id,username during setup). Not a secret by itself,
# but kept server-side alongside the token since it has no other use outside publish calls.
INSTAGRAM_ACCOUNT_ID=
# Optional override, only for pointing a non-production environment at a mock Instagram API.
INSTAGRAM_API_BASE_URL=https://graph.instagram.com
# The single project slug (e.g. "driveset") allowed to publish through the credentials above —
# required, since they're global across every project. Unset/blank -> every project is refused
# (fail closed; see lib/social-account-ownership.ts). Not a per-client credential, just a pin on
# which one project the credentials above already belong to.
INSTAGRAM_OWNER_PROJECT=

# Threads API for Social's "Publish to Threads" (POST /api/social-publications/[id]/publish-threads).
# THREADS_USER_ID is the numeric Threads user id the token below is scoped to — NOT the @username
# (a username is not a valid Threads API user id). THREADS_ACCESS_TOKEN is a long-lived Threads
# User access token with threads_basic + threads_content_publish scopes.
# Server-side only — never stored in the DB or in Git, never read by any client component.
#
# Same FALLBACK status as INSTAGRAM_ACCESS_TOKEN above — each project can instead connect its own
# Threads account from Social → Accounts. See OLNOO_PROJECT_MAP.md's "Social Connect MVP" section.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# Optional override, only for pointing a non-production environment at a mock Threads API. The
# Threads Graph API is versioned (unlike graph.instagram.com) — lib/social-threads.ts appends
# /v1.0 to this base itself.
THREADS_API_BASE_URL=https://graph.threads.net
# The single project slug allowed to publish through the credentials above — same role as
# INSTAGRAM_OWNER_PROJECT, required since THREADS_USER_ID/THREADS_ACCESS_TOKEN are also global.
THREADS_OWNER_PROJECT=

# Shared secret for the Social scheduler sweep (POST /api/social-scheduler/run), which auto-
# publishes Ready posts once their publish_date arrives. Only ever called from this same server —
# a systemd timer runs curl against 127.0.0.1 once a minute, sending this as the
# X-Scheduler-Token header. Unset means the route refuses every request (fails closed, not open).
# Server-side only — never stored in the DB or in Git, never read by any client component.
#
# Also reused, unchanged, by the once-a-day Instagram/Threads token-refresh sweep
# (POST /api/social-token-refresh/run, see OLNOO_PROJECT_MAP.md's "Automatic Instagram/Threads
# token refresh") — a second, independent trigger with the identical localhost-only trust
# boundary, not a second secret to provision.
SOCIAL_SCHEDULER_TOKEN=

# Base URL used to turn an uploaded Social → Instagram image (POST /api/social/upload-instagram-image,
# saved on disk under this app's own uploads/ directory, served back by
# GET /api/social/instagram-image/[project]/[filename]) into the absolute HTTPS URL Instagram's API
# fetches it from. Not a secret. Override only where the app's public origin differs from
# production (e.g. local testing).
PUBLIC_SITE_URL=https://admin.olnoo.com

# Google Ads OAuth MVP (GET /api/ads/google-ads/oauth/start, GET /api/ads/google-ads/oauth/callback)
# — Authorization Code flow only, to obtain a refresh token for a FUTURE read-only Google Ads
# Observer (not built yet). No Google Ads API call is ever made by this app today.
#
# IMPORTANT: the OAuth Client Secret previously configured for this project's Google Cloud OAuth
# client was exposed/leaked. Do NOT reuse that value here or anywhere. Provision a brand-new
# Client Secret in Google Cloud Console (APIs & Services → Credentials → the OAuth 2.0 Client ID →
# "Reset secret" or a new client) before setting these variables for any real use.
#
# From the same Google Cloud OAuth 2.0 Web application client (project "olnoo-ads").
# Server-side only — never stored in the DB or in Git, never read by any client component.
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
# Must exactly match one of the "Authorized redirect URIs" registered on that OAuth client in
# Google Cloud Console (Google requires an exact string match — scheme, host, port, and path).
# e.g. http://localhost:3000/api/ads/google-ads/oauth/callback locally, or
# https://admin.olnoo.com/api/ads/google-ads/oauth/callback in production.
GOOGLE_ADS_OAUTH_REDIRECT_URI=
# Optional override for where the one-time refresh-token bootstrap file is written on success.
# Defaults to secrets/google-ads-refresh-token.json (gitignored — see lib/google-ads-oauth-token-store.ts).
GOOGLE_ADS_OAUTH_TOKEN_FILE=
