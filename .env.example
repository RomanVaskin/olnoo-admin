DATABASE_URL=postgresql://olnoo_admin:CHANGE_ME@localhost:5432/olnoo_admin

# OLNOO AI Router — used server-side only for SEO keyword clustering.
AI_ROUTER_URL=http://127.0.0.1:3010
OLNOO_ROUTER_TOKEN=

# Shared secret for server-to-server lead intake (POST /api/leads/inbound).
# Must match OLNOO_CRM_API_KEY on the public site(s) that submit leads here.
# Server-side only — never read by any client component.
OLNOO_CRM_API_KEY=

# Telegram Bot API token for Social's "Publish to Telegram" (POST /api/social-publications/[id]/publish-telegram).
# Server-side only — never stored in the DB or in Git, never read by any client component.
TELEGRAM_BOT_TOKEN=
# Optional override, only for pointing a non-production environment at a mock Telegram API.
TELEGRAM_API_BASE_URL=https://api.telegram.org

# VK API access token for Social's "Publish to VK" (POST /api/social-publications/[id]/publish-vk).
# Must be a community/group access token (or a user token with wall,groups scope) obtained via
# VK's classic OAuth or the community's own API settings — NOT a vk2.a.* token from the newer
# id.vk.com PKCE login flow, which cannot call wall.post.
# Server-side only — never stored in the DB or in Git, never read by any client component.
VK_ACCESS_TOKEN=
# Optional override, only for pointing a non-production environment at a mock VK API.
VK_API_BASE_URL=https://api.vk.com
